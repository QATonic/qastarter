plugins {
    id 'java'
{{#if (eq reportingTool "allure")}}
    id 'io.qameta.allure' version '{{string toolVersions.allure "single" "gradle"}}'
{{/if}}
}

group = '{{string groupId "single" "gradle"}}'
version = '1.0.0'
sourceCompatibility = '17'

repositories {
    mavenCentral()
}

dependencies {
    // RestAssured
    implementation 'io.rest-assured:rest-assured:{{string toolVersions.restassured "single" "gradle"}}'
    implementation 'io.rest-assured:json-path:{{string toolVersions.restassured "single" "gradle"}}'
    implementation 'io.rest-assured:json-schema-validator:{{string toolVersions.restassured "single" "gradle"}}'
    
    // TestNG
    implementation 'org.testng:testng:{{string toolVersions.testng "single" "gradle"}}'
    
    // JSON
    implementation 'com.google.code.gson:gson:{{string toolVersions.gson "single" "gradle"}}'
    implementation 'com.fasterxml.jackson.core:jackson-databind:{{string toolVersions.jackson "single" "gradle"}}'
    implementation 'com.jayway.jsonpath:json-path:2.9.0'
    
{{#if (eq reportingTool "allure")}}
    // Allure
    implementation 'io.qameta.allure:allure-testng:{{string toolVersions.allure "single" "gradle"}}'
{{/if}}

    // Logging
    implementation 'org.slf4j:slf4j-simple:2.0.9'
    // Log4j2 (used by Log utility / log4j2.xml)
    implementation 'org.apache.logging.log4j:log4j-core:2.22.0'
    implementation 'org.apache.logging.log4j:log4j-api:2.22.0'
{{#if userDependencies.hasMaven}}

// User-picked dependencies (from QAStarter dependency search)
{{#each userDependencies.maven}}
implementation '{{string group "single" "gradle"}}:{{string name "single" "gradle"}}:{{string version "single" "gradle"}}'
{{/each}}
{{/if}}
    {{#if utilities.faker}}
    // DataFaker — Test data generation
    implementation 'net.datafaker:datafaker:{{string toolVersions.datafaker "single" "gradle"}}'
    {{/if}}
}

test {
    useTestNG()
    testLogging {
        events "passed", "skipped", "failed"
    }
}