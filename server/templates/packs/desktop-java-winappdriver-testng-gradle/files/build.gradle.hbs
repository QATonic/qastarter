plugins {
    id 'java'
}

group = '{{string groupId "single" "gradle"}}'
version = '1.0.0'
sourceCompatibility = '17'

repositories {
    mavenCentral()
}

dependencies {
    implementation 'io.appium:java-client:{{string toolVersions.appium "single" "gradle"}}'
    implementation 'org.seleniumhq.selenium:selenium-java:{{string toolVersions.selenium "single" "gradle"}}'
    implementation 'org.testng:testng:{{string toolVersions.testng "single" "gradle"}}'
    implementation 'org.slf4j:slf4j-simple:2.0.9'
    // ExtentReports (used by TestListener)
    implementation 'com.aventstack:extentreports:5.1.1'
    // File utilities (used by ScreenshotUtils)
    implementation 'commons-io:commons-io:2.15.1'
    // Windows native access (used by WindowsUtils)
    implementation 'net.java.dev.jna:jna:5.14.0'
    implementation 'net.java.dev.jna:jna-platform:5.14.0'
{{#if userDependencies.hasMaven}}

// User-picked dependencies (from QAStarter dependency search)
{{#each userDependencies.maven}}
implementation '{{string group "single" "gradle"}}:{{string name "single" "gradle"}}:{{string version "single" "gradle"}}'
{{/each}}
{{/if}}
    {{#if utilities.faker}}
    // DataFaker — Test data generation
    implementation 'net.datafaker:datafaker:{{string toolVersions.datafaker "single" "gradle"}}'
    {{/if}}
}

test {
    useTestNG()
}