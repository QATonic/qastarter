using NUnit.Framework;
using TechTalk.SpecFlow;
using {{projectNamespace}}.Config;
using Microsoft.Playwright;

namespace {{projectNamespace}}.StepDefinitions;

[Binding]
public sealed class LoginSteps
{
    private IPlaywright? _playwright;
    private IBrowser? _browser;
    private IPage _page = null!;

    [BeforeScenario]
    public async Task StartBrowser()
    {
        _playwright = await Microsoft.Playwright.Playwright.CreateAsync();
        _browser = await _playwright.Chromium.LaunchAsync(new() { Headless = ConfigReader.Instance.Headless });
        _page = await _browser.NewPageAsync();
    }

    [AfterScenario]
    public async Task CloseBrowser()
    {
        try { if (_browser != null) await _browser.CloseAsync(); }
        finally { _playwright?.Dispose(); }
    }

    [Given("I open the login page")]
    public async Task OpenLogin() => await _page.GotoAsync(ConfigReader.Instance.BaseUrl);

    private async Task SignIn(string username, string password)
    {
        await _page.FillAsync("#user-name", username);
        await _page.FillAsync("#password", password);
        await _page.ClickAsync("#login-button");
    }

    [When("I sign in with the configured credentials")]
    public Task ValidCredentials() => SignIn(ConfigReader.Instance.Username, ConfigReader.Instance.Password);
    [When("I sign in with a locked account")]
    public Task LockedAccount() => SignIn("locked_out_user", ConfigReader.Instance.Password);
    [When("I sign in with empty credentials")]
    public Task EmptyCredentials() => SignIn("", "");

    [Then("I should see the inventory")]
    public async Task Inventory()
    {
        await _page.WaitForURLAsync("**/inventory.html");
        Assert.That(_page.Url, Does.Contain("/inventory.html"));
    }

    [Then("I should see a login error")]
    public async Task LoginError()
    {
        var error = _page.Locator("[data-test='error']");
        await error.WaitForAsync(new() { State = WaitForSelectorState.Visible });
        Assert.That(await error.InnerTextAsync(), Does.Contain("Epic sadface"));
    }
}
