using NUnit.Framework;
using TechTalk.SpecFlow;
using {{projectNamespace}}.Config;
using OpenQA.Selenium;
using OpenQA.Selenium.Support.UI;
using {{projectNamespace}}.Pages;
using {{projectNamespace}}.Utils;

namespace {{projectNamespace}}.StepDefinitions;

[Binding]
public sealed class LoginSteps
{
    private IWebDriver _driver = null!;
    private LoginPage _login = null!;

    [BeforeScenario]
    public void StartBrowser()
    {
        _driver = DriverManager.InitDriver();
        _login = new LoginPage();
    }

    [AfterScenario]
    public void CloseBrowser() => DriverManager.QuitDriver();

    [Given("I open the login page")]
    public void OpenLogin() => _driver.Navigate().GoToUrl(ConfigReader.Instance.BaseUrl);

    [When("I sign in with the configured credentials")]
    public void ValidCredentials() => _login.Login(ConfigReader.Instance.Username, ConfigReader.Instance.Password);
    [When("I sign in with a locked account")]
    public void LockedAccount() => _login.Login("locked_out_user", ConfigReader.Instance.Password);
    [When("I sign in with empty credentials")]
    public void EmptyCredentials() => _login.Login("", "");

    [Then("I should see the inventory")]
    public void Inventory()
    {
        new WebDriverWait(_driver, TimeSpan.FromSeconds(30)).Until(driver => driver.Url.Contains("/inventory.html"));
        Assert.That(_login.IsLoginSuccessful(), Is.True);
    }

    [Then("I should see a login error")]
    public void LoginError() => Assert.That(_login.GetErrorMessage(), Does.Contain("Epic sadface"));
}
