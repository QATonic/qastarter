FROM golang:1.26-bookworm

WORKDIR /app
COPY go.mod ./
COPY . .
RUN go mod tidy
# Install browsers using the same SDK version as go.mod.
RUN go run github.com/playwright-community/playwright-go/cmd/playwright@v0.5101.0 install --with-deps chromium
ENV HEADLESS=true
CMD ["go", "test", "./tests/...", "-v"]
