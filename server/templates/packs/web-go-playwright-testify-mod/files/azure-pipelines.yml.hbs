trigger:
  - main
pool:
  vmImage: ubuntu-latest
steps:
  - task: GoTool@0
    inputs:
      version: '1.21'
  - script: |
      go mod download
      go run github.com/playwright-community/playwright-go/cmd/playwright@v0.5101.0 install --with-deps chromium
      go test ./... -v
    displayName: Run tests
    env:
      HEADLESS: 'true'
