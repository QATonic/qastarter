plugins {
id 'java'
id 'jacoco'
{{#if (eq reportingTool "allure")}}
id 'io.qameta.allure' version '2.11.2' apply false
{{/if}}
id 'com.diffplug.spotless' version '6.25.0'
}

spotless {
java {
googleJavaFormat('1.17.0').aosp()
}
}

group = '{{string groupId "single" "gradle"}}'
version = '1.0.0'
description = '{{string projectName "single" "gradle"}} - Playwright Test Automation Framework'

java {
sourceCompatibility = JavaVersion.VERSION_11
targetCompatibility = JavaVersion.VERSION_11
}

repositories {
mavenCentral()
}

ext {
// Dependency versions
playwrightVersion = '{{string toolVersions.playwright "single" "gradle"}}'
testngVersion = '{{string toolVersions.testng "single" "gradle"}}'
log4jVersion = '{{string toolVersions.log4j "single" "gradle"}}'
{{#if (eq reportingTool "extent-reports")}}
extentReportsVersion = '{{string toolVersions.extentreports "single" "gradle"}}'
{{/if}}
{{#if (eq reportingTool "allure")}}
allureVersion = '{{string toolVersions.allure "single" "gradle"}}'
{{/if}}
{{#if (eq testingPattern "bdd")}}
cucumberVersion = '{{string toolVersions.cucumber "single" "gradle"}}'
{{/if}}
jacksonVersion = '{{string toolVersions.jackson "single" "gradle"}}'
gsonVersion = '{{string toolVersions.gson "single" "gradle"}}'
commonsCsvVersion = '1.10.0'

// Test configuration
browser = project.hasProperty('browser') ? project.property('browser') : 'chromium'
headless = project.hasProperty('headless') ? project.property('headless') : 'true'
env = project.hasProperty('env') ? project.property('env') : 'dev'
suite = project.hasProperty('suite') ? project.property('suite') : 'testng.xml'
parallel = project.hasProperty('parallel') ? project.property('parallel') : 'false'
threadCount = project.hasProperty('threadCount') ? project.property('threadCount') : '1'
}

dependencies {
// Playwright
implementation "com.microsoft.playwright:playwright:${playwrightVersion}"

// TestNG — used in src/main/java (BaseTest), must be on the compile classpath.
implementation "org.testng:testng:${testngVersion}"
{{#if (eq reportingTool "extent-reports")}}

// ExtentReports
implementation "com.aventstack:extentreports:${extentReportsVersion}"
{{/if}}
{{#if (eq reportingTool "allure")}}

// Allure
testImplementation "io.qameta.allure:allure-testng:${allureVersion}"
{{#if (eq testingPattern "bdd")}}
testImplementation "io.qameta.allure:allure-cucumber7-jvm:${allureVersion}"
{{/if}}
{{/if}}
{{#if (eq testingPattern "bdd")}}

// Cucumber BDD
testImplementation "io.cucumber:cucumber-java:${cucumberVersion}"
testImplementation "io.cucumber:cucumber-testng:${cucumberVersion}"
{{/if}}

// Log4j2
implementation "org.apache.logging.log4j:log4j-core:${log4jVersion}"
implementation "org.apache.logging.log4j:log4j-api:${log4jVersion}"
implementation "org.apache.logging.log4j:log4j-slf4j-impl:${log4jVersion}"

// JSON Processing
implementation "com.fasterxml.jackson.core:jackson-core:${jacksonVersion}"
implementation "com.fasterxml.jackson.core:jackson-databind:${jacksonVersion}"
implementation "com.fasterxml.jackson.core:jackson-annotations:${jacksonVersion}"
implementation "com.google.code.gson:gson:${gsonVersion}"

// CSV Processing
implementation "org.apache.commons:commons-csv:${commonsCsvVersion}"
{{#if (eq cloudDeviceFarm "browserstack")}}

// BrowserStack SDK — auto-instruments Playwright tests to run on
// BrowserStack's cloud based on browserstack.yml at project root.
implementation 'com.browserstack:browserstack-java-sdk:1.25.0'
{{/if}}
{{#if userDependencies.hasMaven}}

// User-picked dependencies (from QAStarter dependency search)
{{#each userDependencies.maven}}
implementation '{{string group "single" "gradle"}}:{{string name "single" "gradle"}}:{{string version "single" "gradle"}}'
{{/each}}
{{/if}}
    {{#if utilities.faker}}
    // DataFaker — Test data generation
    implementation 'net.datafaker:datafaker:{{string toolVersions.datafaker "single" "gradle"}}'
    {{/if}}
}

// Test task configuration
test {
useTestNG() {
// Use TestNG suite files
suites "src/test/resources/${suite}"

// Configure parallel execution
if ((project.findProperty('parallel') ?: 'false') == 'true') {
parallel = 'methods'
threadCount = Integer.parseInt(project.findProperty('threadCount') ?: '1')
}

// System properties for test execution
systemProperty 'browser', browser
systemProperty 'headless', headless
systemProperty 'env', env
}

// Test output
testLogging {
events "passed", "skipped", "failed"
exceptionFormat "full"
}

// Generate reports
reports {
html.required = true
junitXml.required = true
}

// Fail build on test failures
ignoreFailures = false

// JVM settings — attach BrowserStack SDK as a java agent when the pack
// was generated with cloudDeviceFarm=browserstack so every Playwright
// session routes to BrowserStack's cloud based on browserstack.yml.
jvmArgs = ['-Xmx1024m']{{#if (eq cloudDeviceFarm "browserstack")}}
doFirst {
    def sdkJar = configurations.testRuntimeClasspath.find { it.name.startsWith('browserstack-java-sdk') }
    if (sdkJar != null) {
        jvmArgs += ["-javaagent:${sdkJar.absolutePath}"]
    }
}{{/if}}

// Clean reports before test
doFirst {
delete fileTree(dir: "reports", include: "**/*")
delete fileTree(dir: "test-output", include: "**/*")
}
}

// Task to install Playwright browsers
task installPlaywrightBrowsers(type: JavaExec) {
classpath = sourceSets.main.runtimeClasspath
mainClass = 'com.microsoft.playwright.CLI'
args = ['install', '--with-deps']
}

// Custom task for running smoke tests
task smokeTest(type: Test) {
useTestNG() {
suites "src/test/resources/smoke.xml"
systemProperty 'browser', browser
systemProperty 'headless', headless
systemProperty 'env', env
}
}

// Custom task for running regression tests
task regressionTest(type: Test) {
useTestNG() {
suites "src/test/resources/regression.xml"
parallel = 'methods'
threadCount = Integer.parseInt(project.findProperty('threadCount') ?: '3')
systemProperty 'browser', browser
systemProperty 'headless', headless
systemProperty 'env', env
}
}

// Code coverage with JaCoCo
jacoco {
toolVersion = "0.8.10"
}

jacocoTestReport {
dependsOn test
reports {
xml.required = true
csv.required = false
html.required = true
}
}

// Clean task enhancement
clean {
delete "logs"
delete "reports"
delete "test-output"
delete "screenshots"
}

// Gradle wrapper task
wrapper {
gradleVersion = '{{string toolVersions.gradle "single" "gradle"}}'
distributionType = Wrapper.DistributionType.BIN
}
{{#if (eq reportingTool "allure")}}

// Allure configuration
allure {
version = '{{string toolVersions.allure "single" "gradle"}}'
autoconfigure = true
aspectjweaver = true

useTestNG {
version = '{{string toolVersions.allure "single" "gradle"}}'
}
}
{{/if}}