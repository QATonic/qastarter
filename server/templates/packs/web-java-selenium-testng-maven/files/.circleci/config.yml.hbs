version: 2.1
orbs:
  browser-tools: circleci/browser-tools@1.4
jobs:
  test:
    docker:
      - image: cimg/openjdk:{{toolVersions.java}}.0-browsers
    steps:
      - checkout
      - browser-tools/install-chrome
      - restore_cache:
          keys:
            - maven-v1-{{raw}}{{ checksum "pom.xml" }}{{/raw}}
            - maven-v1-
      - run:
          name: Run tests
          command: mvn --batch-mode clean test -Dheadless=true
      - save_cache:
          paths:
            - ~/.m2
          key: maven-v1-{{raw}}{{ checksum "pom.xml" }}{{/raw}}
      - store_test_results:
          path: target/surefire-reports
      - store_artifacts:
          path: target/surefire-reports
workflows:
  tests:
    jobs:
      - test
