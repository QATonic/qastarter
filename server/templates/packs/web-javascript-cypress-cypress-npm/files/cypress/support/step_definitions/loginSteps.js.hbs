import { Given, When, Then } from '@badeball/cypress-cucumber-preprocessor';

Given('I open the login page', () => { cy.visit('/'); });
const signIn = (username, password) => {
  if (username) cy.get('#user-name').type(username);
  if (password) cy.get('#password').type(password);
  cy.get('#login-button').click();
};
When('I sign in with the configured credentials', () => {
  signIn(Cypress.env('username'), Cypress.env('password'));
});
When('I sign in with a locked account', () => { signIn('locked_out_user', Cypress.env('password')); });
When('I sign in with empty credentials', () => { signIn('', ''); });
Then('I should see the inventory', () => { cy.url().should('include', '/inventory.html'); });
Then('I should see a login error', () => { cy.get('[data-test="error"]').should('be.visible').and('contain', 'Epic sadface'); });
