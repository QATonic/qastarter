const { Before, After, Given, When, Then, setDefaultTimeout } = require('@cucumber/cucumber');
const assert = require('node:assert/strict');
const { Builder, By, until } = require('selenium-webdriver');
const chrome = require('selenium-webdriver/chrome');

setDefaultTimeout(60000);
const baseUrl = process.env.BASE_URL || "{{string baseUrl "double" "js"}}";
const username = process.env.TEST_USERNAME || "{{string testUsername "double" "js"}}";
const password = process.env.TEST_PASSWORD || "{{string testPassword "double" "js"}}";
Before(async function () {
  const options = new chrome.Options().addArguments("--no-sandbox", "--disable-dev-shm-usage");
  if (process.env.HEADLESS !== "false") options.addArguments("--headless=new");
  this.driver = await new Builder().forBrowser("chrome").setChromeOptions(options).build();
});
After(async function () {
  await this.driver?.quit();
});
Given('I open the login page', async function () {
  await this.driver.get(baseUrl);
});
async function signIn(username, password) {
  await this.driver.findElement(By.id("user-name")).sendKeys(username);
  await this.driver.findElement(By.id("password")).sendKeys(password);
  await this.driver.findElement(By.id("login-button")).click();
}
When('I sign in with the configured credentials', async function () { await signIn.call(this, username, password); });
When('I sign in with a locked account', async function () { await signIn.call(this, "locked_out_user", password); });
When('I sign in with empty credentials', async function () { await signIn.call(this, "", ""); });
Then('I should see the inventory', async function () {
  await this.driver.wait(until.urlContains("/inventory.html"), 30000);
  assert.ok((await this.driver.getCurrentUrl()).includes("/inventory.html"));
});
Then('I should see a login error', async function () {
  const error = await this.driver.wait(until.elementLocated(By.css('[data-test="error"]')), 30000);
  assert.ok((await error.getText()).includes("Epic sadface"));
});
