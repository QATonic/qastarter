from pytest_bdd import scenarios, given, when, then
from config.config_reader import config

scenarios("../features/login.feature")

@given("I open the login page")
def open_login(page):
    page.goto(config.base_url)

def sign_in(page, username, password):
    page.locator("#user-name").fill(username)
    page.locator("#password").fill(password)
    page.locator("#login-button").click()

@when("I sign in with the configured credentials")
def sign_in_0(page):
    sign_in(page, config.username, config.password)

@when("I sign in with a locked account")
def sign_in_1(page):
    sign_in(page, "locked_out_user", config.password)

@when("I sign in with empty credentials")
def sign_in_2(page):
    sign_in(page, "", "")

@then("I should see the inventory")
def inventory(page):
    page.wait_for_url("**/inventory.html")
    assert "/inventory.html" in page.url

@then("I should see a login error")
def login_error(page):
    assert "Epic sadface" in page.locator('[data-test="error"]').inner_text()
