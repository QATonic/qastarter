name: Robot Framework Tests
on:
  push:
    branches: [main, develop]
  pull_request:
    branches: [main]
  workflow_dispatch:
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '{{toolVersions.python}}'
      - uses: browser-actions/setup-chrome@latest
      - name: Install dependencies
        run: python -m pip install -r requirements.txt
      - name: Run tests
        run: robot --variable HEADLESS:true --xunit junit.xml --outputdir results {{#if (eq reportingTool "allure")}}--listener allure_robotframework:allure-results {{/if}}tests/
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: robot-results
          path: |
            results/
{{#if (eq reportingTool "allure")}}
            allure-results/
{{/if}}
