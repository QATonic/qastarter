stages:
  - test
variables:
  PIP_CACHE_DIR: "$CI_PROJECT_DIR/.cache/pip"
cache:
  paths:
    - .cache/pip/
test:
  stage: test
  image: python:{{toolVersions.python}}
  before_script:
    - apt-get update && apt-get install -y chromium chromium-driver
    - python -m pip install -r requirements.txt
  script:
    - robot --variable BROWSER:chromium --variable HEADLESS:true --xunit junit.xml --outputdir results {{#if (eq reportingTool "allure")}}--listener allure_robotframework:allure-results {{/if}}tests/
  artifacts:
    when: always
    paths:
      - results/
{{#if (eq reportingTool "allure")}}
      - allure-results/
{{/if}}
    reports:
      junit: results/junit.xml
