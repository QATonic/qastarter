trigger:
  - main
  - develop
pool:
  vmImage: ubuntu-latest
steps:
  - task: UsePythonVersion@0
    inputs:
      versionSpec: '{{toolVersions.python}}'
  - script: python -m pip install -r requirements.txt
    displayName: Install dependencies
  - script: robot --variable HEADLESS:true --xunit junit.xml --outputdir results {{#if (eq reportingTool "allure")}}--listener allure_robotframework:allure-results {{/if}}tests/
    displayName: Run tests
  - task: PublishTestResults@2
    condition: always()
    inputs:
      testResultsFormat: JUnit
      testResultsFiles: results/junit.xml
      failTaskOnFailedTests: true
  - task: PublishBuildArtifacts@1
    condition: always()
    inputs:
      PathtoPublish: results
      ArtifactName: robot-results
