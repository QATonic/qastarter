from pytest_bdd import scenarios, given, when, then
from config.config_reader import config
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC

scenarios("../features/login.feature")

@given("I open the login page")
def open_login(driver):
    driver.get(config.base_url)

def sign_in(driver, username, password):
    driver.find_element(By.ID, "user-name").send_keys(username)
    driver.find_element(By.ID, "password").send_keys(password)
    driver.find_element(By.ID, "login-button").click()

@when("I sign in with the configured credentials")
def sign_in_0(driver):
    sign_in(driver, config.username, config.password)

@when("I sign in with a locked account")
def sign_in_1(driver):
    sign_in(driver, "locked_out_user", config.password)

@when("I sign in with empty credentials")
def sign_in_2(driver):
    sign_in(driver, "", "")

@then("I should see the inventory")
def inventory(driver):
    WebDriverWait(driver, 30).until(EC.url_contains("/inventory.html"))

@then("I should see a login error")
def login_error(driver):
    element = WebDriverWait(driver, 30).until(EC.visibility_of_element_located((By.CSS_SELECTOR, '[data-test="error"]')))
    assert "Epic sadface" in element.text
