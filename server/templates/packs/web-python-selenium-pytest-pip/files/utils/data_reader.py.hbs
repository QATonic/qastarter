"""
CSV and JSON test data reader utility
"""
import os
import csv
import json
from pathlib import Path
from typing import List, Dict, Any

# Test-data directory, resolved relative to the project root (utils/ -> ../data).
DATA_DIR = Path(__file__).resolve().parent.parent / "data"


class DataReader:
    """Data reader utility for CSV and JSON"""

    DATA_DIR = DATA_DIR

    @staticmethod
    def read_csv(filename: str) -> List[Dict[str, str]]:
        """
        Read CSV file and return list of dictionaries
        
        Args:
            filename: CSV filename in data directory
            
        Returns:
            List of dictionaries
        """
        file_path = DataReader.DATA_DIR / filename
        with open(file_path, 'r') as csvfile:
            reader = csv.DictReader(csvfile)
            return list(reader)
    
    @staticmethod
    def read_json(filename: str) -> Dict[str, Any]:
        """
        Read JSON file
        
        Args:
            filename: JSON filename in data directory
            
        Returns:
            Dictionary from JSON
        """
        file_path = DataReader.DATA_DIR / filename
        with open(file_path, 'r') as jsonfile:
            return json.load(jsonfile)
    
    @staticmethod
    def get_test_data(key: str) -> Any:
        """
        Get test data from environment-specific JSON
        
        Args:
            key: Data key
            
        Returns:
            Test data value
        """
        env = os.getenv("TEST_ENV", "dev")
        env_file = DataReader.DATA_DIR / f"{env}.json"
        env_data = DataReader.read_json(f"{env}.json") if env_file.exists() else {}
        return env_data.get(key)
