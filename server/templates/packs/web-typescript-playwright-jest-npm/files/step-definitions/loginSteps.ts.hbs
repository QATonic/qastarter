import { Before, After, Given, When, Then, setDefaultTimeout } from '@cucumber/cucumber';
import assert from 'node:assert/strict';
import { chromium, type Browser, type Page } from 'playwright';
type LoginWorld = { browser?: Browser; page: Page };

setDefaultTimeout(60000);
const baseUrl = process.env.BASE_URL || "{{string baseUrl "double" "js"}}";
const username = process.env.TEST_USERNAME || "{{string testUsername "double" "js"}}";
const password = process.env.TEST_PASSWORD || "{{string testPassword "double" "js"}}";
Before(async function (this: LoginWorld) {
  this.browser = await chromium.launch({ headless: process.env.HEADLESS !== "false" });
  this.page = await this.browser.newPage();
});
After(async function (this: LoginWorld) {
  await this.browser?.close();
});
Given('I open the login page', async function (this: LoginWorld) {
  await this.page.goto(baseUrl);
});
async function signIn(this: LoginWorld, username: string, password: string) {
  await this.page.locator("#user-name").fill(username);
  await this.page.locator("#password").fill(password);
  await this.page.locator("#login-button").click();
}
When('I sign in with the configured credentials', async function (this: LoginWorld) { await signIn.call(this, username, password); });
When('I sign in with a locked account', async function (this: LoginWorld) { await signIn.call(this, "locked_out_user", password); });
When('I sign in with empty credentials', async function (this: LoginWorld) { await signIn.call(this, "", ""); });
Then('I should see the inventory', async function (this: LoginWorld) {
  await this.page.waitForURL("**/inventory.html");
  assert.ok(this.page.url().includes("/inventory.html"));
});
Then('I should see a login error', async function (this: LoginWorld) {
  const error = this.page.locator('[data-test="error"]');
  await error.waitFor({ state: "visible" });
  assert.ok((await error.innerText()).includes("Epic sadface"));
});
