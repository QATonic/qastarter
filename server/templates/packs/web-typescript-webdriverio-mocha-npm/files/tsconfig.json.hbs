{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "mocha",
      "@wdio/globals/types"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "test/**/*.ts",
    "config/**/*.ts",
    "wdio.conf.ts",
    "utils/**/*.ts",
    "step-definitions/**/*.ts"
  ]
}
